{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "JR800_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "displayName": "Native Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "wasm-debug",
      "displayName": "WebAssembly Debug",
      "inherits": "base",
      "environment": {
        "EM_CACHE": "${sourceDir}/build/emscripten-cache"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "JR800_REQUIRE_EMSCRIPTEN": "ON"
      }
    },
    {
      "name": "wasm-release",
      "displayName": "WebAssembly Release",
      "inherits": "base",
      "environment": {
        "EM_CACHE": "${sourceDir}/build/emscripten-cache"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "JR800_REQUIRE_EMSCRIPTEN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug"
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release"
    }
  ],
  "testPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "native-release",
      "configurePreset": "native-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm-debug",
      "configurePreset": "wasm-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "wasm-release",
      "configurePreset": "wasm-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
